@page "/ask"
@inject Api Api
@inject Toast Toast
@inject NavigationManager Nav

<PageTitle>Ask</PageTitle>

<header class="topbar">
    <div>
        <h1>Ask</h1>
        <p class="sub">Questions about your money, answered from your data</p>
    </div>
    @if (turns.Count > 0)
    {
        <button type="button" class="btn small nowrap" @onclick="Clear" disabled="@busy">New chat</button>
    }
</header>

@if (configured is false)
{
    <section class="card">
        <h2>Not set up yet</h2>
        <p class="muted">The AI helper needs an Anthropic API key on the server. In Azure, add an app setting
            named <b>Anthropic__ApiKey</b> with your key, then open this screen again.</p>
    </section>
}
else
{
    @if (turns.Count == 0)
    {
        <section class="card">
            <h2>Try asking</h2>
            <div class="chips wrap ask-suggest">
                @foreach (var s in Suggestions)
                {
                    <button type="button" class="chip" disabled="@busy" @onclick="() => Send(s)">@s</button>
                }
            </div>
            <p class="hint">It reads your budget, spending, accounts, subscriptions, investments and goals to answer.
                It can suggest goals, but only saves one when you tap Save.
                Your question and the figures it looks at are sent to Anthropic's AI service.</p>
        </section>
    }

    <div class="chat" aria-live="polite">
        @foreach (var t in turns)
        {
            <div class="bubble @(t.Role switch { "user" => "me", "error" => "error", _ => "ai" })">
                <div class="bubble-text">@t.Text</div>
                @if (t.Looked is { Count: > 0 } looked)
                {
                    <div class="bubble-meta">Checked: @string.Join(" · ", looked)</div>
                }
            </div>
            @if (t.Goals is { Count: > 0 } goals)
            {
                @foreach (var g in goals)
                {
                    <div class="goal-idea @(g.Kind == "Save" ? "savings" : "")">
                        <div class="goal-idea-main">
                            <span class="goal-idea-kind">@(g.Kind == "Save" ? "Save" : "Limit") · per pay period</span>
                            <strong>@(g.Name ?? Target(g))</strong>
                            <span>@(g.Kind == "Save" ? "Put in at least" : $"{Target(g)}: at most") @Fmt.Money(g.Amount)</span>
                            @if (!string.IsNullOrWhiteSpace(g.Reason))
                            {
                                <span class="muted small">@g.Reason</span>
                            }
                        </div>
                        @if (saved.Contains(g))
                        {
                            <a class="btn small nowrap" href="goals">Saved ✓</a>
                        }
                        else
                        {
                            <button type="button" class="btn small primary nowrap" disabled="@saving" @onclick="() => Save(g)">Save goal</button>
                        }
                    </div>
                }
            }
        }
        @if (busy)
        {
            <div class="bubble ai thinking" role="status">Looking through your data…</div>
        }
    </div>

    <form class="ask-box" @onsubmit="() => Send(draft)" @onsubmit:preventDefault>
        <label for="ask-q" class="sr-only">Your question</label>
        <textarea id="ask-q" rows="2" maxlength="1000" placeholder="e.g. Can I afford a $1,200 holiday in March?"
                  @bind="draft" @bind:event="oninput" disabled="@busy"></textarea>
        <button type="submit" class="btn primary" disabled="@(busy || string.IsNullOrWhiteSpace(draft))">Ask</button>
    </form>
}

@code {
    public const string GoalsQuestion = "Look at my spending and suggest goals to help me spend less and save more.";

    private static readonly string[] Suggestions =
    [
        "Can I send my parents $400 a month?",
        GoalsQuestion,
        "Where did most of my money go this pay period?",
        "How am I doing on my goals?",
    ];

    private sealed record Turn(string Role, string Text, List<string>? Looked = null, List<GoalDraft>? Goals = null);

    private readonly List<Turn> turns = [];
    private readonly HashSet<GoalDraft> saved = [];
    private string draft = "";
    private bool busy;
    private bool saving;
    private bool? configured;

    /// <summary>A question to ask straight away, from links such as "Get ideas" on the Goals screen.</summary>
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            configured = (await Api.AskStatus()).Configured;
        }
        catch (ApiException)
        {
            configured = null; // Asking will show the real problem.
        }
        if (!string.IsNullOrWhiteSpace(Q) && configured is not false)
        {
            var q = Q;
            // Drop ?q= so a reload doesn't ask again.
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("q", (string?)null), replace: true);
            await Send(q);
        }
    }

    private async Task Send(string question)
    {
        question = question.Trim();
        if (busy || question.Length == 0) return;

        var history = turns.Where(t => t.Role != "error")
            .Select(t => new AskTurn(t.Role, t.Text)).ToList();
        turns.Add(new Turn("user", question));
        draft = "";
        busy = true;
        try
        {
            var a = await Api.Ask(question, history);
            turns.Add(new Turn("assistant", a.Answer, a.Looked, a.Goals));
        }
        catch (ApiException e)
        {
            turns.Add(new Turn("error", e.Message));
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Save(GoalDraft g)
    {
        if (saving) return;
        saving = true;
        try
        {
            await Api.AddGoal(g);
            saved.Add(g);
            Toast.Show("Goal saved. Track it on the Budget screen.");
        }
        catch (ApiException e)
        {
            Toast.Error(e.Message);
        }
        finally
        {
            saving = false;
        }
    }

    private static string Target(GoalDraft g) => g.Category ?? (g.Bucket is { } b ? $"All {b}" : "Savings");

    private void Clear()
    {
        turns.Clear();
        saved.Clear();
        draft = "";
    }
}
