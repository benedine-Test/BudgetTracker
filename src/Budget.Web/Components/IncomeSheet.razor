@inject Api Api
@inject Toast Toast
@inject IJSRuntime JS

<Sheet Title="Record income" OnClose="OnClose">
    <form @onsubmit="Save" @onsubmit:preventDefault>
        <label for="inc-kind">Type</label>
        <select id="inc-kind" @bind="kind">
            <option value="salary">Salary (sets the budget)</option>
            <option value="other">Other income</option>
            <option value="refund">Refund</option>
        </select>

        @if (kind == "salary")
        {
            <label class="check">
                <input type="checkbox" @bind="fromBase" />
                <span>Work out CPF from my base pay</span>
            </label>
        }

        @if (UseBase)
        {
            <label for="inc-base">Monthly base pay, before CPF (S$)</label>
            <input id="inc-base" type="number" inputmode="decimal" step="0.01" min="0" @bind="basePay" @bind:event="oninput" />

            <div class="two">
                <div>
                    <label for="inc-age">Your age</label>
                    <select id="inc-age" @bind="AgeChoice">
                        <option value="@FromBirth">From my date of birth</option>
                        <option value="@CpfAgeBand.UpTo55">55 and below</option>
                        <option value="@CpfAgeBand.Over55To60">Above 55 to 60</option>
                        <option value="@CpfAgeBand.Over60To65">Above 60 to 65</option>
                        <option value="@CpfAgeBand.Over65To70">Above 65 to 70</option>
                        <option value="@CpfAgeBand.Over70">Above 70</option>
                        <option value="@CpfAgeBand.NoCpf">No CPF (foreigner)</option>
                    </select>
                </div>
                <div>
                    <label for="inc-shg">Self-help fund</label>
                    <select id="inc-shg" @bind="shg">
                        <option value="@ShgFund.None">None / opted out</option>
                        <option value="@ShgFund.Cdac">CDAC</option>
                        <option value="@ShgFund.Mbmf">MBMF</option>
                        <option value="@ShgFund.Sinda">SINDA</option>
                        <option value="@ShgFund.Ecf">ECF</option>
                    </select>
                </div>
            </div>

            @if (ageChoice == FromBirth)
            {
                <label for="inc-dob">Date of birth</label>
                <input id="inc-dob" type="date" @bind="birthDate" @bind:format="yyyy-MM-dd" />
                @if (birthDate is not null)
                {
                    <p class="hint">CPF rates for this pay: @BandName(Band). The rate changes the month after you turn 55, 60, 65 and 70.</p>
                }
            }

            @if (Breakdown is { } b)
            {
                <div class="rows payslip">
                    <div class="row static"><span class="row-main">Base pay</span><span>@Fmt.Money(b.BasePay)</span></div>
                    <div class="row static"><span class="row-main">CPF (@Fmt.Percent(b.CpfRatePct))</span><span>@Fmt.Money(-b.EmployeeCpf)</span></div>
                    @if (shg != ShgFund.None)
                    {
                        <div class="row static"><span class="row-main">@Payslip.ShgName(shg)</span><span>@Fmt.Money(-b.Shg)</span></div>
                    }
                    <div class="row static total"><span class="row-main">Take-home</span><span>@Fmt.Money(b.TakeHome)</span></div>
                    @if (b.TotalCpf > 0)
                    {
                        <div class="row static"><span class="row-main muted">Employer CPF (@Fmt.Percent(Payslip.EmployerRatePct(Band)))</span><span class="muted">@Fmt.Money(b.EmployerCpf)</span></div>
                        <div class="row static"><span class="row-main muted">Into your CPF this month</span><span class="muted">@Fmt.Money(b.TotalCpf)</span></div>
                    }
                </div>
            }
            <p class="hint">2026 rates for citizens and PRs from their third year. CPF stops at S$8,000 of pay. Your CPF holdings on the Invest screen go up by the CPF shown. Bonuses and allowances aren't included — if your payslip shows a different take-home, untick this and type that instead.</p>
        }
        else
        {
            <label for="inc-amount">@(kind == "salary" ? "Take-home pay, after CPF (S$)" : "Amount (S$)")</label>
            <input id="inc-amount" type="number" inputmode="decimal" step="0.01" min="0" @bind="amount" />
        }

        @if (accounts.Count > 0)
        {
            <label for="inc-acc">Paid into</label>
            <select id="inc-acc" @bind="accountId">
                <option value="0">Not sure / skip</option>
                @foreach (var a in accounts)
                {
                    <option value="@a.Id">@a.Name</option>
                }
            </select>
        }

        <label for="inc-date">Date received</label>
        <input id="inc-date" type="date" @bind="date" @bind:format="yyyy-MM-dd" />

        <label for="inc-note">Note (optional)</label>
        <input id="inc-note" type="text" @bind="note" />

        @if (kind == "salary")
        {
            <p class="hint">The budget for that pay period is split using your current percentages. A second salary entry in the same period is added on top. Entered one by mistake? Delete it under Spending → Income and the budget is corrected.</p>
        }
        @if (error is not null)
        {
            <p class="field-error" role="alert">@error</p>
        }
        <button type="submit" class="btn primary block" disabled="@busy">@(busy ? "Saving…" : "Save")</button>
    </form>
</Sheet>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string kind = "salary";
    private decimal? amount;
    private DateTime date = Fmt.Today.ToDateTime(TimeOnly.MinValue);
    private string? note;
    private string? error;
    private bool busy;
    private List<AccountDto> accounts = [];
    private int accountId;

    // Base-pay mode. Remembered on this phone so payday is one number.
    private bool fromBase;
    private decimal? basePay;
    private const string FromBirth = "Birth";
    private string ageChoice = CpfAgeBand.UpTo55.ToString();   // a CpfAgeBand, or FromBirth
    private DateTime? birthDate;
    private ShgFund shg = ShgFund.None;

    private string AgeChoice
    {
        get => ageChoice;
        set => ageChoice = value == FromBirth || Enum.TryParse<CpfAgeBand>(value, out _) ? value : CpfAgeBand.UpTo55.ToString();
    }

    /// <summary>The band for this pay: worked out from the birthday and the date received, or as picked.</summary>
    private CpfAgeBand Band => ageChoice == FromBirth
        ? birthDate is { } d ? Payslip.AgeBandOn(DateOnly.FromDateTime(d), DateOnly.FromDateTime(date)) : CpfAgeBand.UpTo55
        : Enum.Parse<CpfAgeBand>(ageChoice);

    private bool UseBase => kind == "salary" && fromBase;
    private PayslipBreakdown? Breakdown => basePay is > 0 ? Payslip.From(basePay.Value, Band, shg) : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Pay usually lands in a bank account, so start with the first one.
            accounts = (await Api.Accounts()).Accounts.Where(a => a.Kind != "CreditCard").ToList();
            accountId = accounts.FirstOrDefault(a => a.Kind == "Bank")?.Id ?? 0;
        }
        catch (ApiException) { /* the sheet still works without accounts */ }

        try
        {
            fromBase = await JS.InvokeAsync<string?>("budget.getPref", "salaryFromBase") == "1";
            AgeChoice = await JS.InvokeAsync<string?>("budget.getPref", "cpfAge") ?? ageChoice;
            if (DateTime.TryParseExact(await JS.InvokeAsync<string?>("budget.getPref", "birthDate"), "yyyy-MM-dd",
                    System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var dob)) birthDate = dob;
            if (Enum.TryParse(await JS.InvokeAsync<string?>("budget.getPref", "shgFund"), out ShgFund f)) shg = f;
            if (decimal.TryParse(await JS.InvokeAsync<string?>("budget.getPref", "basePay"),
                    System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var p)) basePay = p;
        }
        catch (JSException) { /* prefs are a convenience; defaults are fine */ }
    }

    private async Task Save()
    {
        if (busy) return;

        decimal value;
        decimal? cpf = null;
        var saveNote = string.IsNullOrWhiteSpace(note) ? null : note.Trim();
        if (UseBase)
        {
            if (ageChoice == FromBirth && birthDate is null)
            {
                error = "Enter your date of birth, or pick your age band.";
                return;
            }
            if (Breakdown is not { TakeHome: > 0 } b)
            {
                error = "Enter your base pay above zero.";
                return;
            }
            value = b.TakeHome;
            cpf = b.TotalCpf;
            saveNote ??= BreakdownNote(b);
        }
        else if (amount is > 0)
        {
            value = amount.Value;
        }
        else
        {
            error = "Enter an amount above zero.";
            return;
        }

        busy = true;
        error = null;
        try
        {
            // Midday keeps the entry on the chosen date whatever the time zone handling.
            await Api.RecordIncome(value, kind, Fmt.Iso(DateOnly.FromDateTime(date)) + "T12:00:00", saveNote, accountId == 0 ? null : accountId, cpf);
            if (kind == "salary") await RememberChoices();
            Toast.Show(kind != "salary" ? "Income recorded."
                : cpf is > 0 ? $"Salary recorded. Budget updated, {Fmt.Money(cpf.Value)} added to CPF."
                : "Salary recorded. Budget updated.");
            await OnSaved.InvokeAsync();
        }
        catch (ApiException e)
        {
            error = e.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private string BreakdownNote(PayslipBreakdown b)
    {
        var text = $"Base {Fmt.Money(b.BasePay)}, CPF {Fmt.Money(-b.EmployeeCpf)}, employer CPF {Fmt.Money(b.EmployerCpf)}";
        return shg == ShgFund.None ? text : $"{text}, {Payslip.ShgName(shg)} {Fmt.Money(-b.Shg)}";
    }

    private static string BandName(CpfAgeBand band) => band switch
    {
        CpfAgeBand.UpTo55 => "55 and below",
        CpfAgeBand.Over55To60 => "above 55 to 60",
        CpfAgeBand.Over60To65 => "above 60 to 65",
        CpfAgeBand.Over65To70 => "above 65 to 70",
        _ => "above 70",
    };

    private async Task RememberChoices()
    {
        try
        {
            await JS.InvokeVoidAsync("budget.setPref", "salaryFromBase", fromBase ? "1" : "0");
            if (!fromBase) return;
            await JS.InvokeVoidAsync("budget.setPref", "cpfAge", ageChoice);
            if (birthDate is { } dob)
                await JS.InvokeVoidAsync("budget.setPref", "birthDate", dob.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture));
            await JS.InvokeVoidAsync("budget.setPref", "shgFund", shg.ToString());
            await JS.InvokeVoidAsync("budget.setPref", "basePay", basePay!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture));
        }
        catch (JSException) { /* not worth failing a saved salary over */ }
    }
}